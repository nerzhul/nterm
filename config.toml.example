# NTerm Configuration File
# This file will be automatically created at: ~/.config/nterm/config.toml
# 
# All fields are optional. If not specified, sensible defaults will be used.

# The shell to execute when opening a terminal
# If not specified, uses the $SHELL environment variable, or /bin/bash as fallback
# shell = "/bin/zsh"

# Number of lines to keep in scrollback history
# Default: 10000
# scrollback_lines = 10000

# Enable cursor blinking
# Default: true
# cursor_blink = true

# Keyboard shortcuts configuration
# Use GTK accelerator format: https://docs.gtk.org/gtk4/func.accelerator_parse.html
# Examples: "<Ctrl><Shift>T", "<Alt>N", "<Ctrl>Page_Down"
[bindings]
# Create a new tab
# Default: "<Ctrl><Shift>T"
# new_tab = "<Ctrl><Shift>T"

# Switch to previous tab
# Default: "<Ctrl>Left"
# prev_tab = "<Ctrl>Left"

# Switch to next tab
# Default: "<Ctrl>Right"
# next_tab = "<Ctrl>Right"

# Toggle search in current terminal
# Default: "<Ctrl><Shift>F"
# search = "<Ctrl><Shift>F"
